# Canonical origin, used for metadataBase, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=https://ynwas.com

# Where enquiries from the contact form are delivered. Until this is set the
# form refuses the submission and tells the visitor to phone or email instead —
# see src/app/[locale]/contact/actions.ts. Set it before launch.
ENQUIRY_WEBHOOK_URL=
